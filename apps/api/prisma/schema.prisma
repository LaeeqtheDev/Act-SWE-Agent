generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("healthy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
  events    Event[]
}

model Incident {
  id          String    @id @default(uuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  title       String
  severity    String
  status      String    @default("open")
  errorRate   Float?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  events IncidentEvent[]
  agentActions AgentAction[]
}

// A genuinely different concept from Incident above (which belongs to the
// simulated payments/orders/auth/notification services — kept as a working
// demo of the detection pipeline). This is real: whenever a tool the agent
// actually calls during a live chat or investigation fails — a browse that
// errors, a provider call that times out, a shell command that exits
// non-zero — it's logged here automatically, tied to the session that hit
// it. This is "the agent notices its own session is having a problem," not
// a fake service.
model AgentIncident {
  id             String    @id @default(uuid())
  conversationId String?
  toolName       String
  message        String
  severity       String    @default("medium") // low | medium | high
  status         String    @default("open")    // open | resolved
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
}

model AgentAction {
  id             String    @id @default(uuid())
  // Who proposed this. Required for integration actions: without it, an
  // approved Slack message would be sent using whichever connection
  // happened to resolve — i.e. potentially someone else's workspace.
  userId         String?
  incidentId     String?
  incident       Incident? @relation(fields: [incidentId], references: [id])
  // Set when the action was proposed from a chat conversation rather than
  // an incident investigation — lets performAction() write a follow-up
  // message back into that same chat once the action completes, so the
  // conversation continues naturally instead of going dead after approval.
  conversationId String?
  type           String    @default("investigation") // investigation | rollback | restart_pod | scale | browser_action | file_edit | shell_command | web_search
  status         String    @default("pending")        // pending | approved | rejected | completed
  summary        String?
  confidence     Float?
  evidence       Json?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
}

// The user's own details, used to auto-fill forms the agent encounters —
// job applications, contact forms, signups — so they don't have to retype
// the same information every time. Stored per-user in hosted mode, under a
// single fixed row ("default") in self-host. Deliberately a flexible JSON
// blob rather than fixed columns: what a form needs varies wildly, and the
// user should be able to save whatever fields matter to them.
model UserProfile {
  id        String   @id @default("default")
  fullName  String?
  email     String?
  phone     String?
  location  String?
  country   String?
  dialCode  String?
  linkedin  String?
  github    String?
  website   String?
  resume    String?  // plain-text resume/summary, used for longer form fields
  extra     Json?    // anything else the user wants available to forms
  updatedAt DateTime @updatedAt
}

// A single active AI provider configuration, editable from the settings UI
// instead of only via .env. apiKeyEnc is AES-256-GCM ciphertext (base64) —
// SETTINGS_ENCRYPTION_KEY (server-side only) is required to decrypt it, and
// the plaintext key is never sent back to the frontend after it's saved.
// An OAuth connection to a third-party service (Slack, Notion). Tokens are
// encrypted with the same AES-256-GCM key as provider API keys — see
// lib/crypto.ts. Scoped per-user in hosted mode; a single shared row when
// self-hosting, matching how ProviderConfig works.
model Connection {
  id           String    @id @default(uuid())
  userId       String?   // null in self-host mode
  service      String    // "slack" | "notion"
  accessToken  String    // AES-256-GCM ciphertext, never plaintext
  refreshToken String?   // ciphertext; Notion tokens don't expire, Slack's may
  workspaceName String?  // shown in the UI so people know WHICH workspace
  scopes       String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // One connection per service per user — reconnecting replaces rather than
  // accumulating stale tokens.
  @@unique([userId, service])
}

model ProviderConfig {
  id        String   @id @default("active")
  provider  String
  model     String
  apiKeyEnc String?
  updatedAt DateTime @updatedAt
}

// Only populated in hosted mode (HOSTED_MODE=true). Self-hosted / BYOK usage
// never touches this table — there's no account, no limit, nothing to meter.
// id is the Clerk user id, so this row is created lazily the first time a
// signed-in user completes a task.
model User {
  id          String   @id
  email       String?
  plan        String   @default("free") // free | pro
  tasksUsed   Int      @default(0)
  periodStart DateTime @default(now())
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  createdAt   DateTime @default(now())
}

// Bank-transfer path: a user uploads a receipt, it sits here as "pending"
// until a human (you) reviews and approves/rejects it — never
// auto-approved. This is deliberate: automatically trusting an uploaded
// image as proof of a real bank transfer would be a straightforward fraud
// vector, so a person always makes the actual call.
model PendingPayment {
  id          String   @id @default(uuid())
  userId      String
  receiptPath String
  fileName    String
  amount      String?
  note        String?
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
}

model Conversation {
  id        String        @id @default(uuid())
  title     String?
  userId    String?       // set only in hosted mode — null for self-host (no accounts)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // user | assistant | tool
  content        String
  toolName       String?
  toolCallId     String?
  toolCalls      Json?
  createdAt      DateTime     @default(now())
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  message    String
  timestamp  DateTime @default(now())
}

model Event {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  type      String
  message   String
  timestamp DateTime @default(now())
}

// A task the user wants repeated on a schedule, unattended — "check my
// LinkedIn for messages every hour," "check payments-api health every 30
// minutes." Runs go through the exact same agent loop as chat (same tools,
// same permission gate on writes), just triggered by a scheduler instead of
// a person typing. userId is null in self-host; scoped per-user in hosted
// mode so one person's workflow never runs as someone else's account.
model Workflow {
  id                 String        @id @default(uuid())
  userId             String?
  name               String
  prompt             String
  // Optional additional stages, run in order after `prompt`, each in the
  // same conversation so later stages can see what earlier ones found.
  // A real pipeline — "find businesses, then check their sites, then email
  // them" — is three distinct jobs, and cramming it into one prompt means
  // the agent runs out of steps before reaching stage three.
  stages             Json?
  cron               String        // standard 5-field cron expression
  enabled            Boolean       @default(true)
  notifyOnRun        Boolean       @default(true)
  conversationId     String?       // lazily created on first run — every run of
                                    // this workflow shares one ongoing chat, so
                                    // the agent has real continuity across runs
  consecutiveFailures Int          @default(0) // auto-disables after 3 in a row —
                                                // see workflows.ts for why
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime      @default(now())
  runs               WorkflowRun[]
}

model WorkflowRun {
  id          String    @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id])
  status      String    @default("running") // running | completed | failed
  result      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// In-app notifications — a workflow finishing, an agent-detected incident
// firing, anything that happens while nobody's watching the chat. userId is
// null in self-host mode (a single shared inbox); scoped per-user in
// hosted mode.
model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
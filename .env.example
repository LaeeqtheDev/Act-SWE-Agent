# Root-level example, read automatically by docker-compose.yml.
AI_PROVIDER="groq"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""
GROQ_API_KEY=""

# CHROME_USER_DATA_DIR and ENABLE_LOCAL_DEV_TOOLS only make sense running

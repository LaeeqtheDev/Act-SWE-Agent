# Copy this file to .env (native dev) — Docker Compose sets these itself via
# docker-compose.yml, you don't need this file when running through Docker.

DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/sentinelops?schema=public"
REDIS_HOST="localhost"

# Sprint 7 (AI agent) -- get a key at https://console.anthropic.com/settings/keys
# Without this set, POST /incidents/:id/investigate still responds, but explains
# that the agent isn't configured instead of running a real investigation.
ANTHROPIC_API_KEY=""

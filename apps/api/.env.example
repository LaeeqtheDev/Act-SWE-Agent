DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/sentinelops?schema=public"
REDIS_HOST="localhost"

# --- AI provider (Sprint 7) ---
# Pick ONE provider. Bring your own key — nothing is hosted for you.
AI_PROVIDER="groq"   # anthropic | openai | grok | groq | ollama
# AI_MODEL="claude-sonnet-4-5"   # optional override

ANTHROPIC_API_KEY=""   # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=""      # https://platform.openai.com/api-keys
XAI_API_KEY=""         # Grok — https://console.x.ai
GROQ_API_KEY=""        # https://console.groq.com/keys
# OLLAMA_BASE_URL="http://localhost:11434/v1"   # local models, no key needed

# --- Browser tool ---
# BROWSER_HEADLESS=false makes the agent's browser a REAL VISIBLE WINDOW on
# your screen instead of running invisibly in the background — recommended
# for local dev so you can actually watch it work.
BROWSER_HEADLESS="false"

# Leave CHROME_USER_DATA_DIR unset for a throwaway, logged-out browser (fine
# for public pages). Set it to use your REAL, already-logged-in local Chrome
# profile instead — the agent can then read pages behind your existing logins
# (Gmail, Calendar, anything). Always visible when set. This only works
# running natively (not inside Docker), and only ever automates YOUR OWN
# browser, locally, under your control — it is not a remote/hosted mechanism.
# Close all other Chrome windows first (Chrome locks its profile directory
# while running).
#
# Find your profile path:
#   Windows: %LOCALAPPDATA%\Google\Chrome\User Data
#   macOS:   ~/Library/Application Support/Google/Chrome
#   Linux:   ~/.config/google-chrome
# CHROME_USER_DATA_DIR="C:\Users\you\AppData\Local\Google\Chrome\User Data"

# --- Local dev tools (opt-in, native dev only) ---
# When true, the agent can read/list files in this project and propose file
# edits or shell commands (still gated behind human approval) and open VS
# Code. Never enable this in a hosted/cloud deployment.
ENABLE_LOCAL_DEV_TOOLS="false"
# PROJECT_ROOT points local dev tools at a directory; defaults to the api
# process's own working directory if unset.

# --- Settings UI (paste a key from the app instead of .env) ---
# Required for the in-app "Model & API key" settings panel to store a pasted
# key encrypted at rest. Any random 32+ character string works.
# Generate one: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=""


# --- Hosted mode (Phase 3/4) ---
# Unset/false (default): self-hosted, single-tenant, no accounts, no limits —
# this is the open-source promise, unchanged. Set to "true" to turn on Clerk
# auth + per-account usage metering (10 free tasks/month, 500 on Pro).
HOSTED_MODE="false"

# Only needed when HOSTED_MODE=true. Get these from your Clerk dashboard
# (dashboard.clerk.com -> your app -> API Keys). @clerk/express's
# clerkMiddleware() needs BOTH of these server-side — CLERK_SECRET_KEY alone
# throws "Publishable key is missing" even though it looks like a
# secret-key-only setup. CLERK_PUBLISHABLE_KEY is the same pk_test_/pk_live_
# value as apps/web/.env's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, just without
# that prefix.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# --- Billing (Phase 5) ---
# Only used in hosted mode. Get these from your Stripe dashboard
# (dashboard.stripe.com). Create one recurring "Pro" price first, then copy
# its price id (starts with price_).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Shared secret for the bank-transfer receipt review endpoints
# (GET /billing/pending, POST /billing/pending/:id/approve|rejected).
# Pick any long random string — this is a single-operator admin check, not a
# full role system.
ADMIN_SECRET=""

# --- Bank transfer details (Phase 5) ---
# Your REAL bank account details for receiving transfers. These stay ONLY in
# your own untracked .env — never commit real values here. If left unset,
# the bank-transfer option on /billing hides itself automatically and users
# see "not set up yet, use card payment instead."
BANK_NAME=""
BANK_ACCOUNT_TITLE=""
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
BANK_TRANSFER_NOTE=""  # e.g. "Include your email as the transfer reference"

# --- Task continuation (Phase: workflows) ---
# Max tool-calling turns per chat message or investigation before the agent
# has to wrap up. Higher = can complete longer multi-step tasks, but resends
# more history each turn. If you're on a small free-tier model with a tight
# tokens-per-minute limit (e.g. Groq's 8,000 TPM tier), lower this to avoid
# hitting a rate-limit error mid-task.
AGENT_MAX_TURNS="8"

# --- Email notifications (optional) ---
# Works with Gmail, SendGrid, Resend, AWS SES, or any other SMTP-compatible
# provider — not locked to one vendor. Leave unset and email notifications
# silently no-op (in-app notifications still work regardless).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Self-hosted mode has no per-account email — set this to receive workflow/
# incident notifications at a single operator inbox instead.
NOTIFY_EMAIL=""

# --- Receipt storage (optional) ---
# Leave unset for local disk (apps/api/uploads/receipts/) — zero config,
# fine for a single-instance deployment. Set S3_BUCKET to switch to real
# object storage instead — required if you ever run more than one API
# instance, or redeploy without a persistent volume, since local files
# don't survive either of those. S3_ENDPOINT works with R2, MinIO, or any
# other S3-compatible provider, not just AWS.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Demo widget rate limit (optional) ---
DEMO_RATE_LIMIT="6"
DEMO_RATE_WINDOW_MINUTES="60"

# --- Production hardening ---
# Comma-separated list of origins allowed to call this API. REQUIRED in
# production — leaving it unset means any website can call the API with a
# signed-in user's credentials.
ALLOWED_ORIGINS=""

# Requests per minute, per IP. Usage limits are per-task and don't stop
# someone firing hundreds of requests a minute at your provider bill.
CHAT_RATE_LIMIT="20"
WRITE_RATE_LIMIT="40"

# --- Tool surface ---
# The service-health / Kubernetes / incident tools. Off by default: their
# schemas are resent on every model turn (~500 tokens), which is real money
# on a small budget, and they're useless unless you've seeded the demo
# services. Turn on only if you're actually using the incident features.
ENABLE_INFRA_TOOLS="false"

# --- Integrations (Slack, Notion) ---
# Optional. When set, the agent talks to these services through their APIs
# instead of driving the web UI — much faster and more reliable.
#
# Slack:  api.slack.com/apps -> Create App -> OAuth & Permissions
#         Redirect URL: {PUBLIC_API_URL}/connections/slack/callback
# Notion: notion.so/my-integrations -> New integration -> type: Public
#         Redirect URI: {PUBLIC_API_URL}/connections/notion/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Where the OAuth callback lands and where to send the user afterwards.
# Must match the redirect URL registered with each provider exactly.
PUBLIC_API_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:3000"

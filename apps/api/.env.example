DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/sentinelops?schema=public"
REDIS_HOST="localhost"

# --- AI provider (Sprint 7) ---
# Pick ONE provider. Bring your own key — nothing is hosted for you.
AI_PROVIDER="groq"   # anthropic | openai | grok | groq | ollama
# AI_MODEL="claude-sonnet-4-5"   # optional override

ANTHROPIC_API_KEY=""   # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=""      # https://platform.openai.com/api-keys
XAI_API_KEY=""         # Grok — https://console.x.ai
GROQ_API_KEY=""        # https://console.groq.com/keys
# OLLAMA_BASE_URL="http://localhost:11434/v1"   # local models, no key needed

# --- Browser tool ---
# BROWSER_HEADLESS=false makes the agent's browser a REAL VISIBLE WINDOW on
# your screen instead of running invisibly in the background — recommended
# for local dev so you can actually watch it work.
BROWSER_HEADLESS="false"

# Leave CHROME_USER_DATA_DIR unset for a throwaway, logged-out browser (fine
# for public pages). Set it to use your REAL, already-logged-in local Chrome
# profile instead — the agent can then read pages behind your existing logins
# (Gmail, Calendar, anything). Always visible when set. This only works
# running natively (not inside Docker), and only ever automates YOUR OWN
# browser, locally, under your control — it is not a remote/hosted mechanism.
# Close all other Chrome windows first (Chrome locks its profile directory
# while running).
#
# Find your profile path:
#   Windows: %LOCALAPPDATA%\Google\Chrome\User Data
#   macOS:   ~/Library/Application Support/Google/Chrome
#   Linux:   ~/.config/google-chrome
# CHROME_USER_DATA_DIR="C:\Users\you\AppData\Local\Google\Chrome\User Data"

# --- Local dev tools (opt-in, native dev only) ---
# When true, the agent can read/list files in this project and propose file
# edits or shell commands (still gated behind human approval) and open VS
# Code. Never enable this in a hosted/cloud deployment.
ENABLE_LOCAL_DEV_TOOLS="false"
# PROJECT_ROOT points local dev tools at a directory; defaults to the api
# process's own working directory if unset.

# --- Settings UI (paste a key from the app instead of .env) ---
# Required for the in-app "Model & API key" settings panel to store a pasted
# key encrypted at rest. Any random 32+ character string works.
# Generate one: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=""


# --- Hosted mode (Phase 3/4) ---
# Unset/false (default): self-hosted, single-tenant, no accounts, no limits —
# this is the open-source promise, unchanged. Set to "true" to turn on Clerk
# auth + per-account usage metering (10 free tasks/month, 500 on Pro).
HOSTED_MODE="false"

# Only needed when HOSTED_MODE=true. Get these from your Clerk dashboard
# (dashboard.clerk.com -> your app -> API Keys).
CLERK_SECRET_KEY=""

# --- Billing (Phase 5) ---
# Only used in hosted mode. Get these from your Stripe dashboard
# (dashboard.stripe.com). Create one recurring "Pro" price first, then copy
# its price id (starts with price_).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Shared secret for the bank-transfer receipt review endpoints
# (GET /billing/pending, POST /billing/pending/:id/approve|rejected).
# Pick any long random string — this is a single-operator admin check, not a
# full role system.
ADMIN_SECRET=""

# --- Bank transfer details (Phase 5) ---
# Your REAL bank account details for receiving transfers. These stay ONLY in
# your own untracked .env — never commit real values here. If left unset,
# the bank-transfer option on /billing hides itself automatically and users
# see "not set up yet, use card payment instead."
BANK_NAME=""
BANK_ACCOUNT_TITLE=""
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
BANK_TRANSFER_NOTE=""  # e.g. "Include your email as the transfer reference"
